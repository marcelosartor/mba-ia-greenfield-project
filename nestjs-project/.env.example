# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube <noreply@streamtube.com>"

# Object storage (MinIO in the Compose stack; any S3-compatible endpoint works)
# Always use the Compose service name as the host (never the loopback address).
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=streamtube
STORAGE_SECRET_ACCESS_KEY=streamtube-secret
STORAGE_BUCKET_VIDEOS=videos
STORAGE_BUCKET_THUMBNAILS=thumbnails
# Optional: browser-reachable endpoint used only to sign presigned URLs for a
# browser client (not needed while uploads run inside the Docker network).
# STORAGE_PUBLIC_ENDPOINT=

# Queue (Redis, used by BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379

# Video upload and processing
# Multipart part size in bytes (default 64 MiB; S3 minimum is 5 MiB)
VIDEO_UPLOAD_PART_SIZE_BYTES=67108864
VIDEO_WORKER_CONCURRENCY=1
# Timeout for a single ffprobe/ffmpeg run (default 30 min)
VIDEO_PROCESSING_TIMEOUT_MS=1800000
